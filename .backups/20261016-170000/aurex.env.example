# Managed connector URL. Use http://127.0.0.1:8010 only when the backend and
# connector share the same host. Use HTTPS for a remote/private tunnel.
AUREX_CONNECTOR_SERVICE_URL=http://127.0.0.1:8010

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the identical value on the managed connector host.
AUREX_CONNECTOR_SERVICE_TOKEN=replace-with-a-long-random-token

# Customer authentication database; keep outside public/static directories and restrict its ACL.
AUREX_AUTH_DB=C:\Aurex\data\auth.sqlite3

# SQLite ownership registry; this contains no broker passwords.
AUREX_CONNECTION_DB=C:\Aurex\data\connections.sqlite3

# Cookie behavior: set true only when the browser reaches Aurex over HTTPS.
AUREX_AUTH_COOKIE_SECURE=true
AUREX_ENV=production
# Comma-separated browser origins allowed for state-changing API requests.
AUREX_TRUSTED_ORIGINS=https://terminal.example.com

# Next.js server-side rewrite target; never expose connector tokens to this variable.
AUREX_API_ORIGIN=http://127.0.0.1:8001
