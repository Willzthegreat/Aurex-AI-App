# Managed connector URL. Use http://127.0.0.1:8010 only when the backend and
# connector share the same host. Use HTTPS for a remote/private tunnel.
AUREX_CONNECTOR_SERVICE_URL=http://127.0.0.1:8010

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set the identical value on the managed connector host.
AUREX_CONNECTOR_SERVICE_TOKEN=replace-with-a-long-random-token

# SQLite ownership registry; this contains no broker passwords.
AUREX_CONNECTION_DB=C:\Aurex\data\connections.sqlite3

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this separate from the connector service token.
AUREX_AUTH_SESSION_SECRET=replace-with-another-long-random-secret
